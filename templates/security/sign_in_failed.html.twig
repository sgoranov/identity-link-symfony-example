{% extends 'base.html.twig' %}

{% block title %}Sign-in failed{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
</style>

<div class="example-wrapper">
    <h1>Sign-in failed</h1>

    {% if cancelled %}
        <p>The sign-in was cancelled at Identity Link.</p>
    {% else %}
        <p>Signing in with Identity Link did not succeed. It may have expired or already been used.</p>
    {% endif %}

    <p><a href="{{ path('connect_identity_link_start') }}">Sign in again</a></p>
</div>
{% endblock %}
