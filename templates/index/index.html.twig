{% extends 'base.html.twig' %}

{% block title %}Hello IndexController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ app.token.userData.fullName ?: app.token.userData.displayName ?: app.user.userIdentifier }}</h1>

    You are signed in with Identity Link:
    <ul>
        <li>User ID (<code>sub</code>): <code>{{ app.user.userIdentifier }}</code></li>
        <li>Email: {{ app.token.userData.email ?: 'not shared' }}</li>
        <li>Roles: {{ app.user.roles|join(', ') }}</li>
    </ul>

    <p><a href="{{ logout_path() }}">Sign out</a></p>
</div>
{% endblock %}
